---
import Layout from '../layouts/Layout.astro';
import { PlayableUniverse } from '../components/PlayableUniverse';
---

<Layout title="Vivek Kushwah | Playable SRE 3D Cockpit">
    <div class="fixed inset-0 z-50 bg-[#07090e] w-screen h-screen overflow-hidden">
        {/* Back to Document View Button */}
        <div class="absolute top-6 left-6 z-40">
            <a
                href="/"
                class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-black/70 border border-white/20 text-gray-300 hover:text-white hover:border-[#00f3ff] text-xs font-mono transition-all backdrop-blur-md"
            >
                <span>← Return to Portfolio Overview</span>
            </a>
        </div>

        <PlayableUniverse client:only="react" />
    </div>
</Layout>
