---
import Layout from '../layouts/Layout.astro';
import { Navbar } from '../components/Navbar';
import { Hero } from '../components/Hero';
import { LiveTraceTelemetry } from '../components/LiveTraceTelemetry';
import { ExperienceSection } from '../components/ExperienceSection';
import { ProjectsSection } from '../components/ProjectsSection';
import { CredentialsSection } from '../components/CredentialsSection';
import { SkillMatrixSection } from '../components/SkillMatrixSection';
import { ContactSection } from '../components/ContactSection';
import Footer from '../components/Footer.astro';
import SEOKeywords from '../components/SEOKeywords.astro';
import { EXPERIENCES, PROJECTS, ABOUT, SKILL_CATEGORIES, CONTACT, CERTIFICATIONS } from '../data/portfolio';
---

<Layout title="Vivek Kushwah | Senior Platform & Observability Architect · SRE">
	{/* Sticky Top Header Navigation */}
	<Navbar client:load />

	{/* Main Native Engineering Experience */}
	<main class="min-h-screen bg-[#07090e] text-gray-100 selection:bg-cyan-400 selection:text-black">
		
		{/* 1. Executive Hero with Telemetry Ribbon */}
		<Hero client:load />

		{/* 2. Interactive Distributed Trace & SRE Workbench */}
		<LiveTraceTelemetry client:visible />

		{/* 3. Enterprise Tenures (Nymcard, Zebpay, Rizzle, Vivvix) */}
		<ExperienceSection client:visible />

		{/* 4. Flagship Autonomous AI & Observability Projects */}
		<ProjectsSection client:visible />

		{/* 5. CNCF Certifications & MANIT Academic Foundation */}
		<CredentialsSection client:visible />

		{/* 6. Technical Skill Arsenal Matrix (Searchable) */}
		<SkillMatrixSection client:visible />

		{/* 7. Direct Transmissions & 1-Click Comms */}
		<ContactSection client:visible />
	</main>

	{/* Minimalist Engineering Footer */}
	<Footer />

	{/* Accessible Screen-Reader & Semantic Search Engine Indexing */}
	<div class="sr-only" aria-label="Vivek Kushwah Portfolio Content Index">
		<h1>Vivek Kushwah - Senior Platform &amp; Observability Architect</h1>
		<p>{ABOUT.description}</p>
		<p>{ABOUT.approach}</p>
		<div>
			<h2>Key Architecture Metrics</h2>
			<ul>
				{ABOUT.stats.map(s => (
					<li>{s.label}: {s.value}</li>
				))}
			</ul>
		</div>
		<div>
			<h2>Education</h2>
			<p>{ABOUT.education.degree} - {ABOUT.education.school} ({ABOUT.education.period})</p>
		</div>
		<div>
			<h2>Certifications</h2>
			<ul>
				{CERTIFICATIONS.map(c => (
					<li>{c.name} - {c.issuer} ({c.year})</li>
				))}
			</ul>
		</div>
		<div>
			<h2>Career Experiences</h2>
			{EXPERIENCES.map(exp => (
				<article>
					<h3>{exp.role} at {exp.company} ({exp.period}) - {exp.location}</h3>
					<ul>
						{exp.achievements.map(a => (
							<li>{a}</li>
						))}
					</ul>
					<p>Tech: {exp.technologies.join(', ')}</p>
				</article>
			))}
		</div>
		<div>
			<h2>Featured Projects</h2>
			{PROJECTS.map(p => (
				<article>
					<h3>{p.title}</h3>
					<p>{p.description}</p>
					<p>Tech: {p.technologies.join(', ')}</p>
				</article>
			))}
		</div>
		<div>
			<h2>Technical Stack &amp; Skill Matrix</h2>
			{SKILL_CATEGORIES.map(cat => (
				<div>
					<h3>{cat.category}</h3>
					<p>{cat.skills.join(', ')}</p>
				</div>
			))}
		</div>
		<div>
			<h2>Contact &amp; Transmissions</h2>
			<ul>
				{CONTACT.map(c => (
					<li><a href={c.href}>{c.name}: {c.value}</a></li>
				))}
			</ul>
		</div>
	</div>

	<SEOKeywords />
</Layout>
