---
import Layout from '../layouts/Layout.astro';
import { PlayableUniverse } from '../components/PlayableUniverse';
import SEOKeywords from '../components/SEOKeywords.astro';
import { EXPERIENCES, PROJECTS, ABOUT, SKILL_CATEGORIES, CONTACT } from '../data/portfolio';
---

<Layout title="Vivek Kushwah | Senior Platform & Observability Architect · Playable Cockpit">
	{/* Main Playable Hyperfluid 3D Cockpit with Real-time Themes */}
	<main class="w-screen h-screen overflow-hidden bg-[#07090e]">
		<PlayableUniverse client:only="react" />
	</main>

	{/* Accessible Screen-Reader & Semantic Search Engine Indexing (visually hidden from playable canvas) */}
	<div class="sr-only" aria-label="Vivek Kushwah Portfolio Content Index">
		<h1>Vivek Kushwah - Senior Platform &amp; Observability Architect</h1>
		<p>{ABOUT.description}</p>
		<p>{ABOUT.approach}</p>
		<div>
			<h2>Key Metrics</h2>
			<ul>
				{ABOUT.stats.map(s => (
					<li>{s.label}: {s.value}</li>
				))}
			</ul>
		</div>
		<div>
			<h2>Education</h2>
			<p>{ABOUT.education.degree} - {ABOUT.education.school} ({ABOUT.education.period})</p>
		</div>
		<div>
			<h2>Career Experiences</h2>
			{EXPERIENCES.map(exp => (
				<article>
					<h3>{exp.role} at {exp.company} ({exp.period}) - {exp.location}</h3>
					<ul>
						{exp.achievements.map(a => (
							<li>{a}</li>
						))}
					</ul>
					<p>Tech: {exp.technologies.join(', ')}</p>
				</article>
			))}
		</div>
		<div>
			<h2>Featured Projects</h2>
			{PROJECTS.map(p => (
				<article>
					<h3>{p.title}</h3>
					<p>{p.description}</p>
					<p>Tech: {p.technologies.join(', ')}</p>
				</article>
			))}
		</div>
		<div>
			<h2>Technical Stack &amp; Skill Matrix</h2>
			{SKILL_CATEGORIES.map(cat => (
				<div>
					<h3>{cat.category}</h3>
					<p>{cat.skills.join(', ')}</p>
				</div>
			))}
		</div>
		<div>
			<h2>Contact &amp; Transmissions</h2>
			<ul>
				{CONTACT.map(c => (
					<li><a href={c.href}>{c.name}: {c.value}</a></li>
				))}
			</ul>
		</div>
	</div>

	<SEOKeywords />
</Layout>
