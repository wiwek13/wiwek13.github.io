<footer class="border-t border-white/10 bg-[#05070a] py-12 text-gray-400 text-xs font-mono">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col sm:flex-row items-center justify-between gap-6">
        
        {/* Left: Identity & SLO */}
        <div class="flex items-center gap-3 text-center sm:text-left">
            <div class="w-8 h-8 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold text-xs">
                VK
            </div>
            <div>
                <div class="text-white font-bold text-sm tracking-tight font-sans">
                    Vivek Kushwah
                </div>
                <div class="text-gray-400 text-[11px] flex items-center gap-1.5 justify-center sm:justify-start">
                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                    <span>SLO Target: 99.99% Uptime · Multi-Cloud Architecture</span>
                </div>
            </div>
        </div>

        {/* Center: Direct Quick Links */}
        <div class="flex flex-wrap items-center justify-center gap-4 text-xs">
            <a href="#overview" class="hover:text-cyan-400 transition-colors">Overview</a>
            <a href="#telemetry" class="hover:text-cyan-400 transition-colors">Telemetry</a>
            <a href="#experience" class="hover:text-cyan-400 transition-colors">Experience</a>
            <a href="#projects" class="hover:text-cyan-400 transition-colors">Projects</a>
            <a href="#credentials" class="hover:text-cyan-400 transition-colors">Credentials</a>
            <a href="#skills" class="hover:text-cyan-400 transition-colors">Skills</a>
            <a href="#contact" class="hover:text-cyan-400 transition-colors">Contact</a>
        </div>

        {/* Right: Copyright & Back to Top */}
        <div class="text-center sm:text-right">
            <div>© {new Date().getFullYear()} Vivek Kushwah. All rights reserved.</div>
            <div class="text-[10px] text-gray-500 mt-0.5">Designed with high-craft native performance</div>
        </div>

    </div>
</footer>
